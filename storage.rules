rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper : Vérifie l'authentification du praticien
    function isAuthenticated() {
      return request.auth != null;
    }

    // Dossier sécurisé des photos d'ordonnances médicales
    match /prescriptions/{fileName} {
      // Les patients peuvent UNIQUEMENT uploader (créer) une photo ou un fichier
      // Règles strictes : taille < 10 Mo et type MIME image ou PDF
      allow create: if request.resource.size < 10 * 1024 * 1024
                    && (request.resource.contentType.matches('image/.*')
                        || request.resource.contentType == 'application/pdf');

      // SEUL le kiné authentifié peut lire, télécharger et supprimer les ordonnances
      allow read, delete, update: if isAuthenticated();
    }

    // Interdiction par défaut pour tout autre dossier
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
